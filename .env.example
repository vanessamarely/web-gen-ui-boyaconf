# ── slides/.env.local (deck interactivo + app de asistentes) ─────────────
# Config web de Firebase (no es secreta; la protección son las reglas).
# Sin estas variables el deck funciona en modo ensayo local (BroadcastChannel).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
VITE_SESSION_ID=boyaconf-2026

# ── ambos ───────────────────────────────────────────────────────────────
VITE_SLIDES_URL=https://genui-boyaconf-slides.web.app
VITE_DEMO_URL=https://genui-boyaconf-demo.web.app
